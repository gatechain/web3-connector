{
	// "extends": "@tsconfig/recommended/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"module": "ESNext",
		"target": "ES2015",
		"declaration": true,
		"moduleResolution": "Node",
		"outDir": "./dist",
		"jsx": "react",
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"./src"
	],
	"exclude": [
		"**/*.spec.ts"
	]
}
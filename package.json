{
  "name": "web3-connector-v4",
  "version": "v4.0.0",
  "description": "This is a tool for connecting Web3 wallets.",
  "author": "Thone Liu <thorne_lew@126.com>",
  "homepage": "",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "directories": {},
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "rm -rf dist/ && rollup -c rollup.config.js --bundleConfigAsCjs --watch",
    "dev:watch": "pnpm run dev & node scripts/watch-and-update.js",
    "build": "rm -rf dist/ && cross-env NODE_ENV=production rollup -c rollup.config.js --bundleConfigAsCjs",
    "update-consumer": "node scripts/update-consumer.js",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:staged": "prettier --write \"$(git diff --staged --name-only --diff-filter=ACMR | grep -E \"\\.(js|jsx|ts|tsx|json|css|scss|md)$\" | xargs)\"",
    "prepare": "husky install"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@ethersproject/address": "^5.8.0",
    "@ethersproject/providers": "^5.7.2",
    "@metamask/detect-provider": "^2.0.0",
    "@walletconnect/ethereum-provider": "^2.15.1",
    "js-cookie": "^3.0.5",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@tsconfig/recommended": "^1.0.1",
    "@types/node": "^22.14.1",
    "@types/react": "^18.3.4",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cross-env": "^7.0.3",
    "husky": "^8.0.0",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.21.0",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  }
}
